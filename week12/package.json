{
  "name": "@kwondohun0308/week12-testing-release-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Week12 TDD, unit testing, E2E, and CI sample",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "test": "jest --coverage",
    "test:unit": "jest --runInBand",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "jest": "^30.0.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/config.js",
      "src/legacy-pricing.js",
      "src/release-engine.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}